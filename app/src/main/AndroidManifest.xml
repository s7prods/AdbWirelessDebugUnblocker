<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        tools:ignore="DataExtractionRules">

        <!-- ===== Legacy Xposed / LSPosed module declaration ===== -->
        <!-- Mark this APK as a Xposed module -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <!-- Shown in the LSPosed manager module list -->
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <!-- Minimum Xposed API level required (82 = classic API used here) -->
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!--
            Scope. For a LEGACY module:
              * "android" / "system" both resolve to system_server in LSPosed
                (the manager UI labels the system framework entry "系统框架 / System");
                select the SYSTEM FRAMEWORK entry, NOT the "Android系统 / android"
                system-UI process, otherwise system_server hooks silently do nothing.
              * "com.android.settings" removes the Settings-app Wi-Fi gate.
        -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>

</manifest>
